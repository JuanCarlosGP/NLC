# Copy to `.env` or `.secrets/nas.env`. Those files are gitignored.
# Used by maintainer scripts (OTA notify, APK release), not by the app at runtime.

# NLC_NAS_HOST=192.168.1.10
# NLC_NAS_PORT=5005
# NLC_NAS_USER=Viewer
# NLC_NAS_PASSWORD=
# NLC_NAS_SHARE=/Music/nlc-push-tokens.json

# Optional extra Expo push tokens (comma-separated).
# GitHub Actions cannot reach the NAS on LAN; set EXPO_PUSH_TOKENS as a repo secret
# so CI can ping the APK after an OTA.
# EXPO_PUSH_TOKEN=
# EXPO_PUSH_TOKENS=
