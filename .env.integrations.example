# Copy to .env.integrations.local. Keep this file private (chmod 600).
# Node 22.23+. These values are read only by the local integration service.
NLC_APP_ORIGIN=http://127.0.0.1:8084
NLC_INTEGRATIONS_PORT=8087
# WHOOP: register exactly this callback in your Developer Dashboard.
# If your WHOOP app requires HTTPS, use the local TLS configuration in docs/integrations.md.
WHOOP_REDIRECT_URI=http://127.0.0.1:8087/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Mercury: read-only token. Never use a payment-enabled token here.
MERCURY_API_TOKEN=
# 0 = manual; 15 or more = periodic sync while the service runs.
NLC_SYNC_MINUTES=0
# Optional local HTTPS (change WHOOP_REDIRECT_URI and the app URL too).
# NLC_TLS_CERT=/absolute/path/localhost.pem
# NLC_TLS_KEY=/absolute/path/localhost-key.pem
# Optional custom data directory, mode 0700; files are created mode 0600.
# NLC_INTEGRATIONS_DIR=/absolute/path/private-nlc-integrations
