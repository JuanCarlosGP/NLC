{
  "name": "nlc",
  "version": "0.1.18",
  "private": true,
  "description": "Reproductor Android personal para la biblioteca de un NAS (música, podcasts, vídeo, foco y patrimonio).",
  "license": "SEE LICENSE IN LICENSE",
  "author": "JuanCarlosGP",
  "homepage": "https://github.com/JuanCarlosGP/NLC#readme",
  "bugs": {
    "url": "https://github.com/JuanCarlosGP/NLC/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JuanCarlosGP/NLC.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "android",
    "expo",
    "react-native",
    "navidrome",
    "opensubsonic",
    "webdav",
    "nas",
    "music-player"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "start:go": "adb reverse tcp:8082 tcp:8082 && EXPO_OFFLINE=1 expo start --localhost --port 8082",
    "android": "expo run:android",
    "postinstall": "node scripts/fix-expo-platform-header.mjs",
    "typecheck": "tsc --noEmit",
    "assert:settings": "node scripts/assert-no-camera-in-settings.mjs",
    "apk:sdk": "bash scripts/install-android-sdk.sh",
    "apk:check": "bash scripts/check-android-native.sh",
    "tui": "cargo run --manifest-path tui/Cargo.toml",
    "tui:test": "cargo test --manifest-path tui/Cargo.toml",
    "update:preview": "npx eas-cli update --channel preview && node scripts/notify-ota.mjs preview",
    "update:production": "npx eas-cli update --channel production && node scripts/notify-ota.mjs production",
    "apk:release": "node scripts/release-apk.mjs",
    "ios": "expo run:ios",
    "test:health": "node scripts/test-health-weight.cjs",
    "demo:nas": "python3 scripts/local-demo-nas.py",
    "demo:web": "EXPO_PUBLIC_NLC_DEMO=1 EXPO_OFFLINE=1 EXPO_NO_TELEMETRY=1 expo start --web --localhost --port 8084",
    "test:behavior": "node scripts/test-local-behavior.cjs",
    "test:training": "node scripts/test-training.cjs",
    "test:medication": "node scripts/test-medication.cjs",
    "test:body-photos": "node scripts/test-body-photos.cjs",
    "test:nutrition": "node scripts/test-nutrition.cjs",
    "test:training-analytics": "node scripts/test-training-analytics.cjs",
    "test:health-backup": "node scripts/test-health-backup.cjs",
    "integrations": "node --env-file-if-exists=.env.integrations.local scripts/integrations/server.mjs",
    "test:integrations": "node --test scripts/test-integrations.cjs",
    "test:appearance": "node --test scripts/test-appearance.cjs",
    "test:mercury-mobile": "node --test scripts/test-mercury-mobile.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@ide/backoff": "^1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.18",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.13",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.23.0",
    "nlc-lan-bridge": "file:modules/nlc-lan-bridge",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "fake-indexeddb": "^6.2.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  }
}
